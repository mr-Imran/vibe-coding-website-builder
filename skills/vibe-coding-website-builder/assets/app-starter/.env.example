# Settings for the live app. Type these into the host's "Variables" screen.
# This file only lists their names; real values never go in a file in this folder.

NODE_ENV=production

# A folder that survives restarts (the host's "volume" or "disk"), for the database file.
DATA_DIR=/data

# Used once, on the first start, to create the administrator. Change the password after signing in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to 0 if new people should only be added by an administrator.
ALLOW_SIGNUP=1
